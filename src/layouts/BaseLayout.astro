---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import { site } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
  intro?: boolean;
}
const { title, description = site.description, image = '/og.png', type = 'website', publishedTime, noindex = false, intro = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.handle}` : `${site.name} (${site.handle}) | ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090D" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${site.handle} write-ups`} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700;800&display=swap" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {intro && (
      <script is:inline define:vars={{ base }}>
        try {
          if (!sessionStorage.getItem('kiroku-intro') && location.pathname === base && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.dataset.intro = 'play';
            sessionStorage.setItem('kiroku-intro', '1');
          }
        } catch (e) {}
      </script>
    )}
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Intro />
    <Nav current={Astro.url.pathname} />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      // intro can be skipped by any click or key press; it never blocks pointer events anyway
      const skip = () => document.querySelector('.intro')?.classList.add('skip-now');
      window.addEventListener('pointerdown', skip, { once: true });
      window.addEventListener('keydown', skip, { once: true });
    </script>
  </body>
</html>
