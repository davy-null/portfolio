---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlaceholderBadge from '../../components/PlaceholderBadge.astro';
import { CATEGORIES } from '../../content.config';
import { fmtDate, readingTime } from '../../data/utils';
import { site } from '../../data/profile';

export async function getStaticPaths() {
  const posts = (await getCollection('writeups', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1], all: posts } }));
}
const { post, newer, older, all } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const cat = CATEGORIES[d.category];
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const related = all.filter((p) => p.id !== post.id && (p.data.category === d.category || p.data.tags.some((t) => d.tags.includes(t)))).slice(0, 2);
const ld = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: d.title, description: d.description, datePublished: d.date.toISOString(), dateModified: (d.updated ?? d.date).toISOString(), author: { '@type': 'Person', name: site.name }, keywords: d.tags.join(', ') };
---
<BaseLayout title={d.title} description={d.description} type="article" publishedTime={d.date}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="progress" id="progress" aria-hidden="true"></div>
  <article class="wrap">
    <header class="art-head">
      <p class="card-meta">
        <a class="cat" href={`/writeups/?cat=${d.category}`}>{cat.jp} {cat.label}</a>
        <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
        <span>{readingTime(post.body ?? '')} min read</span>
        <PlaceholderBadge show={d.placeholder} />
      </p>
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
      {d.tags.length > 0 && <div class="chips" style="margin-top:1.25rem">{d.tags.map((t) => <a class="chip" href={`/writeups/?tags=${encodeURIComponent(t)}`}>#{t}</a>)}</div>}
      {d.cover && <Image src={d.cover} alt={d.coverAlt} widths={[700, 1100]} sizes="(min-width:1100px) 700px, 100vw" style="margin-top:2rem;border:1.5px solid #4a4a5c" loading="eager" />}
    </header>
    <div class="art-layout">
      <div>
        <div class="prose" id="prose"><Content /></div>
        <nav class="art-nav" aria-label="More write-ups">
          {newer ? <a href={`/writeups/${newer.id}/`}><small>Newer</small><b>{newer.data.title}</b></a> : <span></span>}
          {older && <a href={`/writeups/${older.id}/`} style="text-align:right"><small>Older</small><b>{older.data.title}</b></a>}
        </nav>
        {related.length > 0 && (
          <section style="margin-top:3rem"><h2 style="font-size:1.3rem;margin-bottom:1rem">Related</h2>
            <div class="log">{related.map((r) => <a href={`/writeups/${r.id}/`}><time>{fmtDate(r.data.date)}</time><h3>{r.data.title}</h3></a>)}</div>
          </section>
        )}
      </div>
      {toc.length > 1 && (
        <aside class="toc" aria-label="On this page"><p>On this page</p>
          <ul>{toc.map((h) => <li class={h.depth === 3 ? 'd3' : ''}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </aside>
      )}
    </div>
  </article>
  <script>
    function init() {
      const bar = document.getElementById('progress');
      const prose = document.getElementById('prose');
      if (!bar || !prose) return;
      const onScroll = () => {
        const r = prose.getBoundingClientRect();
        const total = r.height - window.innerHeight * 0.6;
        bar.style.transform = `scaleX(${Math.min(1, Math.max(0, -r.top / Math.max(total, 1)))})`;
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      // copy buttons
      prose.querySelectorAll('pre').forEach((pre) => {
        if (pre.querySelector('.copy')) return;
        const b = document.createElement('button');
        b.className = 'copy'; b.type = 'button'; b.textContent = 'Copy';
        b.onclick = async () => {
          try { await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText); b.textContent = 'Copied'; }
          catch { b.textContent = 'Press Ctrl+C'; }
          setTimeout(() => (b.textContent = 'Copy'), 1600);
        };
        pre.appendChild(b);
      });
      // heading anchors + toc highlight
      prose.querySelectorAll('h2[id], h3[id]').forEach((h) => {
        if (h.querySelector('.anchor')) return;
        const a = document.createElement('a');
        a.className = 'anchor'; a.href = '#' + h.id; a.textContent = '#'; a.setAttribute('aria-label', 'Link to this section');
        h.appendChild(a);
      });
      const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
      if (links.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((es) => {
          es.forEach((e) => { if (e.isIntersecting) links.forEach((l) => l.classList.toggle('on', l.getAttribute('href') === '#' + e.target.id)); });
        }, { rootMargin: '-20% 0px -70% 0px' });
        prose.querySelectorAll('h2[id], h3[id]').forEach((h) => io.observe(h));
      }
    }
    document.addEventListener('astro:page-load', init);
  </script>
</BaseLayout>
